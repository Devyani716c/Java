import java.sql.*;

public class Exp21 {
    public static void main(String[] args) throws Exception {
        Connection c = DriverManager.getConnection(
            "jdbc:mysql://localhost:3306/companydb",
            "root", "YOUR_PASSWORD");

        Statement s = c.createStatement();

        s.executeUpdate("CREATE TABLE IF NOT EXISTS student " +
            "(id INT PRIMARY KEY, name VARCHAR(30))");

        s.executeUpdate("DELETE FROM student");
        s.executeUpdate("INSERT INTO student VALUES (1,'Amit')");

        PreparedStatement p = c.prepareStatement(
            "INSERT INTO student VALUES (?,?)");
        p.setInt(1, 2);
        p.setString(2, "Neha");
        p.executeUpdate();

        ResultSet r = s.executeQuery("SELECT * FROM student");

        while (r.next())
            System.out.println(r.getInt(1) + " " + r.getString(2));

        p = c.prepareStatement(
            "UPDATE student SET name=? WHERE id=?");
        p.setString(1, "Raj");
        p.setInt(2, 1);
        p.executeUpdate();

        p = c.prepareStatement("DELETE FROM student WHERE id=?");
        p.setInt(1, 2);
        p.executeUpdate();

        c.close();
    }
}
