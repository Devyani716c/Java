USE companydb;

CREATE TABLE IF NOT EXISTS account (
    id INT PRIMARY KEY,
    balance INT
);

INSERT IGNORE INTO account VALUES (1, 1000), (2, 500);

DROP PROCEDURE IF EXISTS GetBalance;

DELIMITER //
CREATE PROCEDURE GetBalance(IN aid INT)
BEGIN
    SELECT balance FROM account WHERE id = aid;
END //
DELIMITER ;

import java.sql.*;

public class Exp22 {
    public static void main(String[] args) throws Exception {
        Connection c = DriverManager.getConnection(
            "jdbc:mysql://localhost:3306/companydb",
            "root", "YOUR_PASSWORD");

        c.setAutoCommit(false);

        try {
            Statement s = c.createStatement();
            s.executeUpdate(
                "UPDATE account SET balance=balance-100 WHERE id=1");
            s.executeUpdate(
                "UPDATE account SET balance=balance+100 WHERE id=2");

            c.commit();
            System.out.println("Transaction completed");
        } catch (Exception e) {
            c.rollback();
            System.out.println("Transaction failed");
        }

        CallableStatement cs = c.prepareCall("{call GetBalance(?)}");
        cs.setInt(1, 2);
        ResultSet r = cs.executeQuery();

        while (r.next())
            System.out.println("Balance: " + r.getInt(1));

        c.close();
    }
}
