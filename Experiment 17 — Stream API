import java.util.*;

public class Exp17 {
    public static void main(String[] args) {
        List<Integer> a = Arrays.asList(5, 2, 4, 1);

        int sum = a.stream()
            .filter(n -> n % 2 == 0)
            .map(n -> n * 2)
            .sorted()
            .reduce(0, (x, y) -> x + y);

        System.out.println(sum);
    }
}
