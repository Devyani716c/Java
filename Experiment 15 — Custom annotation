import java.lang.annotation.*;

@Retention(RetentionPolicy.RUNTIME)
@interface Info {
    String value();
}

public class Exp15 {
    @Info("My Annotation")
    public void show() {
        System.out.println("Hello");
    }

    public static void main(String[] args) throws Exception {
        Exp15 e = new Exp15();
        e.show();

        Info i = Exp15.class
            .getMethod("show")
            .getAnnotation(Info.class);

        System.out.println(i.value());
    }
}
