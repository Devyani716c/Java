import java.util.Arrays;

public class Exp3 {
    public static void main(String[] args) {
        int[] a = {5, 2, 4, 1};
        Arrays.sort(a);
        System.out.println(Arrays.toString(a));

        int[][] b = {{4, 2}, {3, 1}};
        for (int[] row : b) {
            Arrays.sort(row);
            System.out.println(Arrays.toString(row));
        }
    }
}
